# CyberShield Network Monitor - Agent Environment Configuration
CYBERSHIELD_AGENT_NAME="CyberShield Network Agent"

# Network Interface selection ('auto' for default route, or specific adapter name e.g. "Wi-Fi", "Ethernet")
CYBERSHIELD_INTERFACE=auto

# Optional custom path to TShark binary if not in PATH (e.g. C:\Program Files\Wireshark\tshark.exe)
CYBERSHIELD_TSHARK_PATH=

# Monitoring Subsystems toggles
CYBERSHIELD_CAPTURE_PACKETS=true
CYBERSHIELD_MONITOR_CONNECTIONS=true
CYBERSHIELD_MONITOR_BANDWIDTH=true

# Capture adapter: 'auto', 'tshark', 'pyshark', or 'synthetic'
CYBERSHIELD_FORCE_ADAPTER=auto
CYBERSHIELD_FALLBACK_SYNTHETIC=true

# Polling and aggregation intervals (seconds)
CYBERSHIELD_INTERVAL_BANDWIDTH=1.0
CYBERSHIELD_INTERVAL_CONNECTIONS=3.0
CYBERSHIELD_INTERVAL_AGGREGATION=1.0
CYBERSHIELD_INTERVAL_HEALTH_CHECK=5.0

# Memory constraints (in-memory ring buffer limits)
CYBERSHIELD_MAX_PACKET_EVENTS=5000
CYBERSHIELD_MAX_CONNECTIONS=2000
CYBERSHIELD_MAX_ALERTS=500
